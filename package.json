{
  "name": "task-buddy-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"yellow,cyan\" \"npm run server:dev\" \"npm run client\"",
    "start": "node server/server.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
